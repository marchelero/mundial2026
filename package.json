{
  "name": "mundial2026-polla",
  "version": "1.2.9",
  "private": true,
  "description": "Polla Mundial 2026 - Express + SQLite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node dev.js",
    "reset": "node scripts/reset.js",
    "seed": "node scripts/seed.js",
    "seed-results": "node scripts/seed-results.js",
    "seed-predictions": "node scripts/seed-predictions.js",
    "recalc-points": "node scripts/recalc-points.js",
    "rs": "npm run reset && npm run seed && npm run recalc-points",
    "rsd": "npm run rs && npm run dev",
    "backend": "node backend/server.js",
    "frontend": "node frontend/server.js",
    "test": "curl -s http://localhost:3000/api/health"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "compression": "^1.8.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^9.14.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": ">=18"
  }
}
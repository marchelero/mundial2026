# .htaccess para cPanel (Apache + Passenger)
# Esto permite que Passenger (módulo de Node.js) maneje las rutas

RewriteEngine On

# Si el archivo o directorio solicitado existe, sírvelo directamente
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Todo lo demás lo maneja Node.js via Passenger
RewriteRule ^ index.js [L]

# Headers de seguridad
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# Cache para assets estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# Prohibir acceso a archivos sensibles
<FilesMatch "^(\.env|\.env\..*|package\.json|package-lock\.json|server\.js|db\.js|app\.json|README\.md|LICENSE\.md)$">
  Require all denied
</FilesMatch>

# Denegar acceso a directorios sensibles
<DirectoryMatch "(node_modules|data)">
  Require all denied
</DirectoryMatch>

# =============================================
# CONFIGURACIÓN - Mundial 2026 Polla
# Copia este archivo como .env y completá los valores
# =============================================

# Admin emails para acceder al panel de admin (separados por coma)
ADMIN_EMAILS=tu@email.com,otro@email.com

# PocketBase admin (para setup.js)
PB_URL=http://127.0.0.1:8090
PB_ADMIN_EMAIL=admin@email.com
PB_ADMIN_PASS=tu_contraseña

# Google OAuth (para login con Google)
# https://console.cloud.google.com/apis/credentials -> crear OAuth Client ID (Web application)
# Redirect URI: http://localhost:8090/api/oauth2-redirect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

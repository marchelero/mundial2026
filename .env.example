# ===========================================
# Modo desarrollo (separado: frontend + backend)
# ===========================================

# Puerto del frontend (npm run dev / npm run frontend)
FRONTEND_PORT=3000

# Puerto del backend API (npm run dev / npm run backend)
BACKEND_PORT=3001

# URL del backend para el proxy del frontend (modo desarrollo)
BACKEND_URL=http://localhost:3001

# ===========================================
# Modo produccion / cPanel (npm start)
# Puerto combinado para un solo proceso
# ===========================================
PORT=3000

# Entorno: development o production
NODE_ENV=development

# Secreto para firmar JWT. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=genera-un-string-aleatorio-largo-y-seguro-aqui

# Google OAuth Client ID (Web application). El MISMO valor en frontend/public/config.js
# En "Authorized JavaScript origins" agregar cada dominio (localhost:3000, tudominio.com)
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Emails admin separados por coma. Mismos que en frontend/public/config.js
ADMIN_EMAILS=admin1@email.com,admin2@email.com

# ===========================================
# VAPID Keys para Web Push Notifications
# Generar con: npx web-push generate-vapid-keys
# ===========================================
VAPID_PUBLIC_KEY=genera-tu-llave-publica-aqui
VAPID_PRIVATE_KEY=genera-tu-llave-privada-aqui
VAPID_SUBJECT=https://mundial.i-logic.net/

# ===========================================
# WhatsApp API (notificaciones a grupos)
# ===========================================
WHATSAPP_API_KEY=tu-api-key-aqui
WHATSAPP_HOST=localhost
WHATSAPP_PORT=8080
WHATSAPP_PATH=/message/sendText/teste
WHATSAPP_GROUP=id-del-grupo@g.us
